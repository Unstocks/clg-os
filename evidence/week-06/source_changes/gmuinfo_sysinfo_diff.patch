 #include "gmuos.h"
 
+/* ------------------------------------------------------------------
+ * Local ABI System Call Wrappers (Verified 16-bit real-mode calling)
+ * ------------------------------------------------------------------ */
+
+/* Query kernel API level via vector 0x0057 (os_get_api_version)
+ * OUT: AL = API version integer (18) */
+static inline int local_get_api_version(void)
+{
+    gmu_u16 ax_val = 0;
+    __asm__ volatile (
+        "xorw %%ax, %%ax\n\t"
+        "movw $0x0057, %%bx\n\t"
+        "callw *%%bx"
+        : "=a" (ax_val)
+        :
+        : "bx", "cx", "dx", "si", "di", "cc", "memory"
+    );
+    return (int)(ax_val & 0xFFu);
+}
+
+/* Query formatted RTC time string via vector 0x0054 (os_get_time_string)
+ * IN: BX = memory offset in DS/ES where string is written */
+static inline void local_get_time_string(char *buf)
+{
+    gmu_u16 off = gmu_offset(buf);
+    __asm__ volatile (
+        "pushw %%es\n\t"
+        "pushw %%ds\n\t"
+        "popw %%es\n\t"
+        "cld\n\t"
+        "movw $0x0054, %%ax\n\t"
+        "callw *%%ax\n\t"
+        "popw %%es"
+        :
+        : "b" (off)
+        : "ax", "cx", "dx", "si", "di", "cc", "memory"
+    );
+}
+
+/* Query formatted RTC calendar date via vector 0x005D (os_get_date_string)
+ * IN: BX = memory offset in DS/ES where string is written */
+static inline void local_get_date_string(char *buf)
+{
+    gmu_u16 off = gmu_offset(buf);
+    __asm__ volatile (
+        "pushw %%es\n\t"
+        "pushw %%ds\n\t"
+        "popw %%es\n\t"
+        "cld\n\t"
+        "movw $0x005D, %%ax\n\t"
+        "callw *%%ax\n\t"
+        "popw %%es"
+        :
+        : "b" (off)
+        : "ax", "cx", "dx", "si", "di", "cc", "memory"
+    );
+}
+
+/* Query conventional base memory size in KB via BIOS int 12h
+ * OUT: AX = contiguous memory in KB (typically 640 KB) */
+static inline int local_get_base_memory_kb(void)
+{
+    gmu_u16 mem_kb = 0;
+    __asm__ volatile (
+        "int $0x12"
+        : "=a" (mem_kb)
+        :
+        : "cc"
+    );
+    return (int)mem_kb;
+}
+
+/* CPU Segment Register Observers */
+static inline gmu_u16 local_get_cs(void)
+{
+    gmu_u16 seg;
+    __asm__ volatile ("movw %%cs, %0" : "=r" (seg));
+    return seg;
+}
+
+static inline gmu_u16 local_get_ds(void)
+{
+    gmu_u16 seg;
+    __asm__ volatile ("movw %%ds, %0" : "=r" (seg));
+    return seg;
+}
+
+static inline gmu_u16 local_get_ss(void)
+{
+    gmu_u16 seg;
+    __asm__ volatile ("movw %%ss, %0" : "=r" (seg));
+    return seg;
+}
+
+/* ------------------------------------------------------------------
+ * Modular Output Helpers (Pure Integer / Teletype)
+ * ------------------------------------------------------------------ */
+
+static void print_int(int n)
+{
+    char buf[8];
+    int pos = 0;
+
+    if (n < 0) {
+        gmu_print_char('-');
+        n = -n;
+    }
+
+    if (n == 0) {
+        gmu_print_char('0');
+        return;
+    }
+
+    while (n > 0 && pos < 7) {
+        buf[pos++] = (char)('0' + (n % 10));
+        n /= 10;
+    }
+
+    while (pos > 0) {
+        gmu_print_char(buf[--pos]);
+    }
+}
+
+static void print_hex16(gmu_u16 val)
+{
+    static const char hex_chars[] = "0123456789ABCDEF";
+    gmu_print("0x");
+    gmu_print_char(hex_chars[(val >> 12) & 0x0F]);
+    gmu_print_char(hex_chars[(val >> 8)  & 0x0F]);
+    gmu_print_char(hex_chars[(val >> 4)  & 0x0F]);
+    gmu_print_char(hex_chars[val         & 0x0F]);
+}
